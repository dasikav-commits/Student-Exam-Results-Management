datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users Table
model SystemUser {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  role          String   @default("LECTURER") // 'LECTURER' | 'ADMIN'
  // Extended auth fields (not in core spec but required for login/admin)
  fullName      String?  @map("full_name")
  passwordHash  String?  @map("password_hash")
  isHod         Boolean  @default(false) @map("is_hod")
  isActiveLec   Boolean  @default(false) @map("is_active_lec")
  isExamLec     Boolean  @default(false) @map("is_exam_lec")

  // Password Recovery Fields
  recoveryEmail    String?   @map("recovery_email")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  createdAt     DateTime @default(now()) @map("created_at")

  activeModules Module[] @relation("ActiveLecturer")
  examModules   Module[] @relation("ExamLecturer")

  moderationDepartment String @default("CIS") @map("moderation_department")
  moderationContact String? @map("moderation_contact")
  moderationDecision ModerationPanelDecision?
  moderationCourses ModerationCourseLecturer[]

  @@map("system_users")
}

// 2. Course Modules Table (Leverages native Prisma Json type matching JSONB)
model Module {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  name             String
  credits          Int          @default(3)
  eligibleStudents Int          @default(0) @map("eligible_students")
  deadline         DateTime?    @map("deadline")
  isFrozen         Boolean      @default(false) @map("is_frozen")
  activeLecturerId Int?         @map("active_lecturer_id")
  examLecturerId   Int?         @map("exam_lecturer_id")
  // stats stores: caComponents, finalBlueprint, examTemplate
  stats            Json         @default("{}")

  activeLecturer SystemUser?   @relation("ActiveLecturer", fields: [activeLecturerId], references: [id], onDelete: SetNull)
  examLecturer   SystemUser?   @relation("ExamLecturer",   fields: [examLecturerId],  references: [id], onDelete: SetNull)
  studentMarks   StudentMark[]
  moderationDepartment String @default("CIS") @map("moderation_department")
  moderationPapers ModerationPaper[]
  moderationLecturers ModerationCourseLecturer[]

  @@map("modules")
}

// 3. Detailed Question-by-Question Marks Ledger
model StudentMark {
  id                      Int     @id @default(autoincrement())
  moduleCode              String  @map("module_code")
  studentIndex            String  @map("student_index")
  // { "comp_uuid": { "Q1": 15, "Q2": 10 } }
  caQuestionsMarks        Json    @default("{}") @map("ca_questions_marks")
  // Sectioned Theory (MCQ + Essay) and Practical question marks; legacy flat Qn JSON is normalized on read.
  finalExamQuestionsMarks Json    @default("{}") @map("final_exam_questions_marks")
  // Second Examiner's independent marks in the same sectioned shape.
  secondExamMarks         Json    @default("{}") @map("second_exam_marks")
  // { "comp_uuid": true }
  isAbsentCa              Json    @default("{}") @map("is_absent_ca")
  isAbsentTheory           Boolean @default(false) @map("is_absent_theory")
  isAbsentPractical       Boolean @default(false) @map("is_absent_practical")
  // Compatibility summary: true when both parent sections are absent.
  isAbsentFinal           Boolean @default(false) @map("is_absent_final")
  // Cohort eligibility. The HOD authorises the cohort size when the module is
  // created (modules.eligible_students), so every roster row starts eligible;
  // the Active Lecturer unticks students who fall outside it. Ineligible rows
  // are excluded from completeness audits, totals, CSV and PDF exports.
  isEligible              Boolean @default(true) @map("is_eligible")

  module Module @relation(fields: [moduleCode], references: [code], onDelete: Cascade)

  @@unique([moduleCode, studentIndex])
  @@map("student_marks")
}

// Paper moderation is a distinct pre-exam workflow; it does not update marks or blueprints.
enum PaperModerationStatus {
  UNDER_MODERATION
  REVISION_REQUIRED
  APPROVED
  DRAFT
  FINALIZED
}

enum PaperModerationAction {
  SUBMIT
  REQUEST_REVISION
  RESUBMIT
  APPROVE
  SAVE_DRAFT
  FINALIZE
}

model ModerationPaper {
  id            Int                   @id @default(autoincrement())
  moduleId      Int                   @map("module_id")
  academicYear  String                @map("academic_year")
  semester      Int
  reference     String
  status        PaperModerationStatus @default(UNDER_MODERATION)
  version       Int                   @default(1)
  submittedById Int                   @map("submitted_by_id")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  module        Module                @relation(fields: [moduleId], references: [id], onDelete: NoAction)
  events        ModerationEvent[]
  files         ModerationFile[]
  bundleVersion Int? @map("bundle_version")
  handoffAt DateTime? @map("handoff_at")
  filePasswordHash String? @map("file_password_hash")

  @@unique([moduleId, academicYear, semester])
  @@map("moderation_papers")
}

model ModerationEvent {
  id        Int                   @id @default(autoincrement())
  paperId   Int                   @map("paper_id")
  actorId   Int                   @map("actor_id")
  version   Int
  action    PaperModerationAction
  note      String
  details   Json?
  createdAt DateTime              @default(now()) @map("created_at")
  paper     ModerationPaper       @relation(fields: [paperId], references: [id], onDelete: NoAction)

  @@unique([paperId, version])
  @@map("moderation_events")
}

model ModerationFile {
  id          Int     @id @default(autoincrement())
  paperId     Int     @map("paper_id")
  version     Int
  slot        String
  name        String
  contentType String  @map("content_type")
  content     Bytes
  protected   Boolean @default(false)
  paper       ModerationPaper @relation(fields: [paperId], references: [id], onDelete: NoAction)

  @@unique([paperId, version, slot])
  @@map("moderation_files")
}

model ModerationSettings {
  department String @id
  academicYear String @map("academic_year")
  semester     Int

  @@map("moderation_settings")
}

model ModerationPanelDecision {
  userId   Int @id @map("user_id")
  approved Boolean
  user     SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("moderation_panel_decisions")
}

model ModerationCourseLecturer {
  moduleId Int @map("module_id")
  userId   Int @map("user_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user     SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([moduleId, userId])
  @@index([userId])
  @@map("moderation_course_lecturers")
}
